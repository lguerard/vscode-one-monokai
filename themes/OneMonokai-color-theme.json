      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "name": "Embedded String Begin/End",
